# Copy this file to .env and adjust if needed.
# All variables are prefixed with SPECTRA_ (see app/core/config.py).

SPECTRA_APP_NAME="Spectra API"
SPECTRA_ENVIRONMENT=development
SPECTRA_HOST=127.0.0.1
SPECTRA_PORT=8000

# Phase 9 resource posture — read by the GPU-aware model scheduler.
SPECTRA_POWER_PROFILE=BALANCED
SPECTRA_MAX_VRAM_BUDGET_GB=4.5
SPECTRA_MAX_RAM_BUDGET_GB=10.0

# Per-profile VRAM budgets (GB) and idle-unload timeouts (s).
SPECTRA_ECO_VRAM_BUDGET_GB=2.5
SPECTRA_BALANCED_VRAM_BUDGET_GB=4.0
SPECTRA_PERFORMANCE_VRAM_BUDGET_GB=4.5
SPECTRA_ECO_IDLE_UNLOAD_SECONDS=30
SPECTRA_BALANCED_IDLE_UNLOAD_SECONDS=120
SPECTRA_PERFORMANCE_IDLE_UNLOAD_SECONDS=600

# Set to true to evict models for RAM pressure (defaults to off).
SPECTRA_ENABLE_RAM_BUDGET_ENFORCEMENT=false
